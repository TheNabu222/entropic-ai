generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/neocities_manager/nextjs_space/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SitePage {
  id            String   @id @default(cuid())
  path          String   @unique
  filename      String
  directory     String
  extension     String
  fileType      String   @default("html")
  size          Int      @default(0)
  lastModified  DateTime?
  isOrphan      Boolean  @default(false)
  isStub        Boolean  @default(false)
  wordCount     Int      @default(0)
  title         String?
  category      String?
  inboundLinks  Int      @default(0)
  outboundLinks String[]  @default([])
  lastScanned   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  template      Template? @relation(fields: [templateId], references: [id])
  templateId    String?
}

model Template {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  htmlContent String     @db.Text
  editableFields Json     @default("[]")
  category    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  pages       SitePage[]
}

model AppSettings {
  id                String   @id @default("default")
  neocitiesApiKey   String?
  stubWordThreshold Int      @default(200)
  orphanIgnorePaths String[] @default([])
  lastFullScan      DateTime?
  autoScanEnabled   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model FileCache {
  id           String   @id @default(cuid())
  path         String   @unique
  content      String?  @db.Text
  htmlPreview  String?  @db.Text
  links        String[] @default([])
  lastFetched  DateTime @default(now())
}
